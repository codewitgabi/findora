SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM="Findora <no-reply@findora.local>"
SMTP_USE_TLS=true
LOGIN_MAX_ATTEMPTS=5
PASSWORD_RESET_MAX_REQUESTS=3
RATE_LIMIT_WINDOW_MINUTES=15
# Days to keep finished reports and read notifications; 0 disables the purge.
RETENTION_DAYS=365
