# Comma-separated campus email domains allowed to register; empty allows any.
ALLOWED_EMAIL_DOMAINS=""
FRONTEND_URL="http://localhost:5173"
PASSWORD_RESET_EXPIRE_MINUTES=30
# Leave SMTP_HOST empty in development: reset emails are written to the log.
SMTP_HOST=""
